#!/bin/bash
# -----------------------------------------------------------------------------
# Project: Arch Linux Custom ISO & Offline Repository Builder
# File: 3_releng
# Description: Stage 3 - Archiso Profile Customization
#              Copies the standard releng archiso profile, overlays custom system
#              configurations, sets up user skeletons, appends custom live packages,
#              adjusts profile permissions, and configures UEFI boot parameters.
#
# License: GNU General Public License v3.0 (GPL-3.0-or-later)
# SPDX-License-Identifier: GPL-3.0-or-later
# -----------------------------------------------------------------------------
set -e

echo "$(date "+%Y-%m-%d %H:%M:%S") - Starting archlive setup..."

# Copy the standard Arch Linux releng profile as the base template
echo "Copying standard archiso releng profile..."
rm -rf archlive
cp -r /usr/share/archiso/configs/releng/ archlive

# Save generated package manifests into etc/skel for access in the installed environment
cp packages_pacman.x86_64 etc/skel/packages_pacman.x86_64
cp packages.x86_64 etc/skel/packages.x86_64

# Overlay custom configurations (users, groups, skeletons, scripts) into the live rootfs
echo "Overlaying custom /etc filesystem tree into archlive..."
cp -r etc/* archlive/airootfs/etc/

# Append live environment utilities (desktop, diagnostics, partition tools) to package manifest
echo "Appending live environment packages..."
cat packages_live.x86_64 >> archlive/packages.x86_64

# Security and access customizations:
# 1. Remove tty1 automatic login to enforce standard user authentication
rm -f archlive/airootfs/etc/systemd/system/getty@tty1.service.d/autologin.conf

# 2. Grant passwordless sudo privilege to the wheel group in the live environment
echo "%wheel ALL=(ALL) NOPASSWD: ALL" >> archlive/airootfs/etc/sudoers

# 3. Customize ISO image naming prefix (archlinux -> cstm-archlinux)
sed -i 's/"archlinux/"cstm-archlinux/' archlive/profiledef.sh

# 4. Set secure read-only permission mask for /etc/gshadow in profiledef.sh
sed -i '/\["\/etc\/shadow"\]="0:0:400"/a \  ["\/etc\/gshadow"]="0:0:400"' archlive/profiledef.sh

# Bootloader customizations:
# 1. Configure UEFI systemd-boot entry with copytoram=no and expand copy-on-write overlay space
sed -i 's/%ARCHISO_UUID%/%ARCHISO_UUID% copytoram=no cow_spacesize=100%/' archlive/efiboot/loader/entries/01-archiso-linux.conf

# 2. Turn off systemd-boot loader timeout/editor menu
sed -i 's/^timeout.*/timeout 0/' archlive/efiboot/loader/loader.conf
echo "editor no" >> archlive/efiboot/loader/loader.conf

echo "$(date "+%Y-%m-%d %H:%M:%S") - Archlive setup completed successfully."
