#!/bin/bash
set -e

echo "$(date "+%Y-%m-%d %H:%M:%S") - Starting package setup..."

rm -rf mePkg
mkdir mePkg
#sudo cp -r /var/cache/pacman/pkg/* mePkg/
sudo chown -R $(whoami):$(whoami) mePkg
sudo chmod -R 777 mePkg

comm -23 <(pacman -Qqe | sort) <(pacman -Qqm | sort) > etc/skel/packages_pacman.x86_64
pacman -Qqe > etc/skel/packages.x86_64

rm -f deps.txt
for pkg in $(cat etc/skel/packages_pacman.x86_64)
do
	pactree -lu "$pkg" >> deps.txt
done
# Strip version constraints (e.g. >=, <=, =) and [unresolvable] lines
sed -i -e 's/[<>=].*//' -e '/\[unresolvable\]/d' deps.txt
sort -u deps.txt > deps.txt.temp
mv deps.txt.temp deps.txt
sed -i '/\[unresolvable\]/d' deps.txt

sudo pacman -Sywd --cachedir ./mePkg $(cat deps.txt) --noconfirm

sudo repo-add mePkg/mePkg.db.tar.gz mePkg/*.zst

tar -cf mePkg.tar mePkg

echo "$(date "+%Y-%m-%d %H:%M:%S") - Package setup completed."

