#!/bin/bash
set -e

exec > build.log 2>&1

echo "$(date "+%Y-%m-%d %H:%M:%S") - Starting ISO build..."

# Limit CPU usage to 75% of total system capacity
quota=$(( $(nproc) * 50 ))%
time sudo systemd-run --scope -p CPUQuota="$quota" mkarchiso -v archlive

echo "$(date "+%Y-%m-%d %H:%M:%S") - ISO build completed."

echo "$(date "+%Y-%m-%d %H:%M:%S") - Injecting offline repo into ISO..."

iso=$(ls out/*-x86_64.iso)
repo_iso="$(basename "${iso%.iso}")-wrepo.iso"

xorriso -indev "$iso" \
	-outdev "$repo_iso" \
	-boot_image any replay \
	-map mePkg /mePkg \
	-commit

sudo mv "$repo_iso" out/

echo "$(date "+%Y-%m-%d %H:%M:%S") - Offline repo injected: out/$repo_iso"
