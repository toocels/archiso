#!/bin/bash
# -----------------------------------------------------------------------------
# Project: Arch Linux Custom ISO & Offline Repository Builder
# File: 4_cleanup
# Description: Stage 4 - Build Artifact Cleanup
#              Removes all intermediate and output files generated by
#              1_pkgs, 2_releng, and 3_build, restoring the repository to
#              its pre-build source state.
#
# License: GNU General Public License v3.0 (GPL-3.0-or-later)
# SPDX-License-Identifier: GPL-3.0-or-later
# -----------------------------------------------------------------------------
set -e

echo "$(date "+%Y-%m-%d %H:%M:%S") - Cleaning up build artifacts..."

# Artifacts from 1_pkgs (offline repository assembly; deps.txt is already
# self-cleaned at the end of that script, removed here too just in case)
echo "Removing package assembly artifacts (mePkg, package lists)..."
rm -rf mePkg mePkg.tar packages.x86_64 packages_pacman.x86_64 deps.txt

# Artifacts from 2_releng (archiso profile staging)
echo "Removing archlive profile and generated etc/skel manifests..."
rm -rf archlive
rm -f etc/skel/packages.x86_64 etc/skel/packages_pacman.x86_64

# Artifacts from 3_build (mkarchiso runs as root via sudo, so work/ and out/
# are root-owned and need sudo to remove)
echo "Removing mkarchiso work/output directories and build.log..."
sudo rm -rf work out
rm -f build.log

echo "$(date "+%Y-%m-%d %H:%M:%S") - Cleanup completed successfully."
