#!/bin/bash
# -----------------------------------------------------------------------------
# Project: Arch Linux Custom ISO & Offline Repository Builder
# File: 1_init
# Description: Stage 1 - Workspace Initialization
#              Prepares the dedicated /iso build directory, sets proper user
#              permissions, and stages repository files for subsequent builds.
#
# License: GNU General Public License v3.0 (GPL-3.0-or-later)
# SPDX-License-Identifier: GPL-3.0-or-later
# -----------------------------------------------------------------------------
set -e

echo "$(date "+%Y-%m-%d %H:%M:%S") - Starting initialization..."

# Detect invoking non-root user and primary group if executed via sudo
TARGET_USER="${SUDO_USER:-$(id -un)}"
TARGET_GROUP="$(id -gn "${TARGET_USER}")"

# Clean up any existing /iso directory to ensure an idempotent build environment
echo "Preparing dedicated /iso build directory..."
sudo rm -rf /iso
sudo mkdir /iso

# Assign ownership of /iso to the target user so non-root build operations succeed
sudo chown "${TARGET_USER}:${TARGET_GROUP}" /iso

# Copy all project build assets, manifests, and configs into /iso
echo "Copying project sources into /iso..."
cp -r * /iso

echo "$(date "+%Y-%m-%d %H:%M:%S") - Initialization completed. Please change directory: cd /iso"
